generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MemberRole {
  ADMIN
  MEMBER
}

enum MemberStatus {
  ACTIVE
  SUSPENDED
}

enum MilestoneStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
}

enum ResourceType {
  CREDENTIAL
}

enum IssuePriority {
  URGENT
  HIGH
  MEDIUM
  LOW
  NO_PRIORITY
}

model User {
  id                 String          @id @default(cuid())
  email              String          @unique
  emailVerified      DateTime?
  name               String?
  passwordHash       String
  avatarUrl          String?
  mustChangePassword Boolean         @default(false)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  deletedAt          DateTime?

  sessions       Session[]
  memberships    Membership[]
  invitesCreated Invite[]        @relation("InviteCreatedBy")
  passwordResets PasswordReset[]
  assignedIssues Issue[]         @relation("IssueAssignee")
  comments       Comment[]
  auditLogs      AuditLog[]
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

model Workspace {
  id        String   @id
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teams Team[]
}

model Team {
  id          String    @id
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  name        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  memberships Membership[]
  projects    Project[]

  @@index([workspaceId])
}

model Membership {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  teamId    String
  team      Team         @relation(fields: [teamId], references: [id])
  role      MemberRole
  status    MemberStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([userId, teamId])
  @@index([teamId, role, status])
}

model Invite {
  id          String     @id @default(cuid())
  email       String
  role        MemberRole
  tokenHash   String     @unique
  expiresAt   DateTime
  consumedAt  DateTime?
  createdById String
  createdBy   User       @relation("InviteCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([email])
  @@index([createdById])
}

model PasswordReset {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId])
}

model Project {
  id          String    @id @default(cuid())
  teamId      String
  team        Team      @relation(fields: [teamId], references: [id])
  name        String
  key         String    @unique
  description String?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  spec       Spec?
  milestones Milestone[]
  resources  Resource[]
  board      Board?

  @@index([teamId])
}

model Spec {
  id        String   @id @default(cuid())
  projectId String   @unique
  project   Project  @relation(fields: [projectId], references: [id])
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Milestone {
  id        String          @id @default(cuid())
  projectId String
  project   Project         @relation(fields: [projectId], references: [id])
  title     String
  dueDate   DateTime?
  status    MilestoneStatus @default(PLANNED)
  rank      String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  deletedAt DateTime?

  issues Issue[]

  @@unique([projectId, rank])
  @@index([projectId, status])
}

model Resource {
  id         String       @id @default(cuid())
  projectId  String
  project    Project      @relation(fields: [projectId], references: [id])
  type       ResourceType @default(CREDENTIAL)
  name       String
  ciphertext String
  iv         String
  authTag    String
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  deletedAt  DateTime?

  @@index([projectId])
}

model Board {
  id        String   @id @default(cuid())
  projectId String   @unique
  project   Project  @relation(fields: [projectId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  columns Column[]
}

model Column {
  id        String   @id @default(cuid())
  boardId   String
  board     Board    @relation(fields: [boardId], references: [id])
  name      String
  rank      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  issues Issue[]

  @@unique([id, boardId])
  @@unique([boardId, rank])
}

model Issue {
  id          String        @id @default(cuid())
  boardId     String
  columnId    String
  column      Column        @relation(fields: [columnId, boardId], references: [id, boardId])
  title       String
  description String?
  assigneeId  String?
  assignee    User?         @relation("IssueAssignee", fields: [assigneeId], references: [id])
  priority    IssuePriority @default(NO_PRIORITY)
  milestoneId String?
  milestone   Milestone?    @relation(fields: [milestoneId], references: [id])
  rank        String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  labels   IssueLabel[]
  comments Comment[]

  @@unique([columnId, rank])
  @@index([boardId])
  @@index([assigneeId])
  @@index([milestoneId])
}

model Label {
  id        String     @id @default(cuid())
  name      String
  color     String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  issues IssueLabel[]
}

model IssueLabel {
  issueId   String
  issue     Issue    @relation(fields: [issueId], references: [id])
  labelId   String
  label     Label    @relation(fields: [labelId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([issueId, labelId])
  @@index([labelId])
}

model Comment {
  id        String    @id @default(cuid())
  issueId   String
  issue     Issue     @relation(fields: [issueId], references: [id])
  authorId  String
  author    User      @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([issueId])
  @@index([authorId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([actorId])
  @@index([entityType, entityId])
}
